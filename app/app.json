{
  "expo": {
    "name": "MyDhobi",
    "slug": "mydhobi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/mydhobi-icon.png",
    "scheme": "mydhobi",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mydhobi.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F0FF",
          "image": "./assets/mydhobi-splash.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ]
    ]
  }
}
