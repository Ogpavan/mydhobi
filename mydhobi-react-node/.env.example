DATABASE_URL=postgresql://user:password@localhost:5432/mydhobi
DATABASE_SSL=false
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=7d
PORT=4000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DB_POOL_MAX=10
MSGCLUB_API_URL=https://msg.icloudsms.com/rest/services/sendSMS/sendGroupSms
MSGCLUB_AUTH_KEY=replace-with-your-msgclub-auth-key
MSGCLUB_SENDER_ID=DEMOOS
MSGCLUB_ROUTE_ID=1
MSGCLUB_SMS_CONTENT_TYPE=english
MSGCLUB_TMID=140200000022
MSGCLUB_CONCENT_FAILOVER_ID=30
# Set these when your MsgClub DLT templates require them.
MSGCLUB_ENTITY_ID=
MSGCLUB_TEMPLATE_ID=
MSGCLUB_LOGIN_OTP_MESSAGE=Your MyDhobi login OTP is {otp}. It is valid for {minutes} minutes. Do not share it.
MSGCLUB_PASSWORD_RESET_MESSAGE=Your MyDhobi password reset OTP is {otp}. It is valid for {minutes} minutes. Do not share it.
