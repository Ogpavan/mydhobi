{
  "name": "mydhobi-react-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run typecheck && npm run build -w @mydhobi/web && npm run build -w @mydhobi/api",
    "deploy:myserver": "bash scripts/deploy-myserver.sh",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "format": "prettier --write apps packages scripts tests *.json *.ts *.md",
    "format:check": "prettier --check apps packages scripts tests *.json *.ts *.md",
    "test": "tsx --tsconfig apps/api/tsconfig.json --test tests/*.test.ts",
    "start": "node --env-file-if-exists=.env scripts/start.mjs",
    "test:browser": "playwright test",
    "preview:fixtures": "tsx --tsconfig apps/api/tsconfig.json scripts/preview-fixtures.ts",
    "admin:create": "tsx --env-file-if-exists=.env --tsconfig apps/api/tsconfig.json apps/api/src/database/create-admin.ts",
    "db:migrate": "tsx --env-file-if-exists=.env --tsconfig apps/api/tsconfig.json apps/api/src/database/migrate.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.7.2"
  }
}
